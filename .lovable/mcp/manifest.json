{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "al-bahr-travels-mcp",
      "version": "0.1.0",
      "title": "Al-Bahr Travels & Consultants"
    },
    "tools": [
      {
        "name": "list_services",
        "title": "List services",
        "description": "List the booking and consultancy services offered by Al-Bahr Travels & Consultants.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_countries",
        "title": "List supported countries",
        "description": "List the countries Al-Bahr supports for a given service. Medical = Gulf only, Visa = Europe only, Flight/Hotel = worldwide.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "service": {
              "type": "string",
              "enum": [
                "medical",
                "visa",
                "flight",
                "hotel"
              ],
              "description": "Service key. Determines which country list to return."
            }
          },
          "required": [
            "service"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_contact_info",
        "title": "Get contact info",
        "description": "Return the public branch address, phone, WhatsApp, and email for Al-Bahr Travels & Consultants.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_blogs",
        "title": "List published blogs",
        "description": "List public blog posts published by Al-Bahr Travels & Consultants (title, slug, excerpt, published date).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 10,
              "description": "Maximum number of blog posts to return (1–50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
